            <LinearLayout android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="50.0dp">
                <TextView android:textSize="16.0sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="低速计数:" />
                <TextView android:gravity="center_vertical" android:id="@id/tv_move_counter" android:layout_width="wrap_content" android:layout_height="match_parent" />
            </LinearLayout>
            <LinearLayout android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="50.0dp">
                <TextView android:textSize="16.0sp" android:textStyle="bold" android:textColor="@color/black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="等待上报:" />
