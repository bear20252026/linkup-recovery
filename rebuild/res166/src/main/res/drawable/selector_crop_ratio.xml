<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <corners android:radius="12.0dp" />
            <stroke android:width="2.0dp" android:color="@color/color_white" />
            <padding android:top="6.0dp" android:bottom="6.0dp" />
        </shape>
    </item>
    <item android:state_checked="false">
        <shape>
            <corners android:radius="12.0dp" />
            <stroke android:width="1.0dp" android:color="@color/color_f8f8f8" />
            <padding android:top="6.0dp" android:bottom="6.0dp" />
        </shape>
    </item>
</selector>
