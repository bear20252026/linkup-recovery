<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorCard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <Button
            android:id="@+id/track_back"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/track_list_back" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/track_record_title"
            android:textColor="@color/appPrimary"
            android:textSize="18sp" />
        <Button
            android:id="@+id/track_refresh"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/refresh" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/track_map_container"
        android:layout_width="match_parent"
        android:layout_height="72dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/track_map_pending"
            android:textColor="@color/appSecondary" />
    </FrameLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/track_dates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/track_loading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:contentDescription="@string/loading"
        android:visibility="gone" />
    <TextView
        android:id="@+id/track_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/track_list_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
