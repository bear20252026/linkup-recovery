<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#e9eef2">

    <FrameLayout
        android:id="@+id/track_map_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_track_map_mask" />

    <View
        android:id="@+id/track_map_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#f8f8f8" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">

            <ImageButton
                android:id="@+id/track_back"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/track_list_back"
                android:paddingHorizontal="16dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_left_32_32" />

            <TextView
                android:id="@+id/track_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:alpha="0"
                android:text="@string/track_record_title"
                android:textColor="@color/appPrimary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/track_refresh"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="@string/refresh"
                android:textColor="@color/appPrimary"
                android:textSize="14sp" />
        </FrameLayout>

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/track_coordinator"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/track_map_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/track_map_pending"
                android:textColor="@color/appSecondary"
                android:textSize="12sp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/track_reset_card"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="16dp"
                app:cardBackgroundColor="@color/colorCard"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.4"
                    android:contentDescription="@string/track_map_pending"
                    android:enabled="false"
                    android:scaleType="center"
                    android:src="@drawable/ic_track_record_reset" />
            </androidx.cardview.widget.CardView>

            <com.mc.fastkit.view.shape.ShapedConstraintLayout
                android:id="@+id/track_sheet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:behavior_fitToContents="false"
                app:behavior_hideable="false"
                app:behavior_peekHeight="123dp"
                app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
                app:mc_contentColor="@color/colorCard"
                app:mc_topLeftRadius="32dp"
                app:mc_topRightRadius="32dp">

                <ImageView
                    android:id="@+id/track_tab_background"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_track_list_tab_bg"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.mc.fastkit.view.shape.ShapedImageView
                    android:id="@+id/track_sheet_indicator"
                    android:layout_width="36dp"
                    android:layout_height="5dp"
                    android:layout_marginTop="6dp"
                    android:importantForAccessibility="no"
                    android:src="#1a3c3c43"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:mc_cornerSize="2.5dp" />

                <HorizontalScrollView
                    android:id="@+id/track_date_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginTop="2dp"
                    android:scrollbars="none"
                    app:layout_constraintTop_toBottomOf="@id/track_sheet_indicator">

                    <LinearLayout
                        android:id="@+id/track_dates"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/track_date_scroll">

                    <TextView
                        android:id="@+id/track_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:gravity="center"
                        android:padding="16dp"
                        android:textColor="@color/appSecondary"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/track_list_container"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/track_loading"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:contentDescription="@string/loading"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/track_date_scroll" />
            </com.mc.fastkit.view.shape.ShapedConstraintLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </LinearLayout>
</FrameLayout>
